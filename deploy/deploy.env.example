# Copy to deploy/deploy.env and edit. deploy.env is gitignored — it holds a
# hostname and a key path, which do not belong in a public repo.

# Hostname or IP of the web server.
PARK_HOST=ec2-xx-xx-xx-xx.compute-1.amazonaws.com

# Login user. ec2-user on Amazon Linux; ssm-user if you connect via Session Manager.
PARK_USER=ec2-user

# Path to the SSH private key. Leave empty to use your ssh-agent / ~/.ssh/config.
PARK_KEY=

# Directory Apache serves the game from. Must be a dedicated subdirectory:
# the deploy clears $PARK_REMOTE/assets to stop old bundles accumulating.
PARK_REMOTE=/data/var/www/html/fun/theme

# Public URL of the game, used only for a post-deploy check. Optional.
PARK_URL=
